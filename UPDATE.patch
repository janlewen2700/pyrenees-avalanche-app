--- /dev/null
+++ b/files_to_markdown.py
@@ -0,0 +1,18 @@
+"""Review export for text source. Use a ZIP when binary assets are needed."""
+from pathlib import Path
+import argparse
+SKIP_DIRS={'.git','node_modules','__pycache__','.venv','venv','dist','browsers'}
+TEXT_SUFFIXES={'.js','.cjs','.mjs','.ts','.tsx','.jsx','.json','.html','.css','.md','.txt','.py','.sql','.yml','.yaml','.toml','.webmanifest','.svg'}
+def combine_files_to_markdown(folder_path,output_file):
+ root=Path(folder_path).resolve();out=Path(output_file).resolve()
+ with out.open('w',encoding='utf-8') as target:
+  for path in sorted(root.rglob('*')):
+   relative=path.relative_to(root)
+   if not path.is_file() or path.is_symlink() or path.resolve()==out or any(p in SKIP_DIRS for p in relative.parts):continue
+   if path.name.startswith('.env') or path.suffix.lower() in {'.pem','.key'}:continue
+   if path.suffix.lower() not in TEXT_SUFFIXES and path.name not in {'LICENSE','.gitignore'}:continue
+   try:content=path.read_text(encoding='utf-8')
+   except UnicodeError:continue
+   target.write(f'# {root.name}/{relative.as_posix()}\n\n{content}\n\n---\n\n')
+if __name__=='__main__':
+ parser=argparse.ArgumentParser();parser.add_argument('folder');parser.add_argument('--out',default='combined_files_output.md');a=parser.parse_args();combine_files_to_markdown(a.folder,a.out)
